{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://aha.o-o.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://aha.o-o.co/:path*",
      "permanent": true
    }
  ],
  "buildCommand": "true",
  "outputDirectory": "public"
}

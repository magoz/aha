{
  "name": "plans",
  "version": "0.1.0",
  "private": true,
  "description": "Personal HTML publishing for agents. Private by default; publish via R2 marker objects.",
  "bin": {
    "plans": "./dist/cli/plans.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b && tsup && chmod +x dist/cli/plans.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config oxlint.config.ts .",
    "lint:fixtures": "node tools/oxlint/verify-fixtures.mjs",
    "test": "vitest run",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm lint:fixtures && pnpm test && pnpm build",
    "dev": "tsx server/node-server.ts",
    "gateway": "tsx gateway/private-gateway.ts",
    "plans": "tsx cli/plans.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@effect/platform-node": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.115",
    "@oxlint/plugins": "1.78.0",
    "@types/node": "24.10.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.0"
}

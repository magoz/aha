{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": [
    "lib/**/*.ts",
    "api/**/*.ts",
    "cli/**/*.ts",
    "server/**/*.ts",
    "gateway/**/*.ts",
    "catalog/**/*.ts",
    "tools/preview*.ts",
    "tools/catalog-showcase.ts",
    "tests/**/*.ts",
    "tools/oxlint/**/*.ts",
    "oxlint.config.ts",
    "tsup.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tools/oxlint/anti-slop/**",
    "tools/oxlint/fixtures/**",
    "infra"
  ]
}

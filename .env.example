# Service (Vercel / Node server). Never commit real values.
AHA_OWNER_TOKEN=replace-with-owner-bearer-token
AHA_PRIVATE_READ_TOKEN=replace-with-private-read-bearer-token
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=aha-dev
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_REGION=auto
# Canonical share-URL base. Defaults to https://aha.oox.sh when unset.
# AHA_PUBLIC_URL=https://aha.oox.sh

# Local development only.
PORT=3939
HOST=127.0.0.1
AHA_ENDPOINT=http://127.0.0.1:3939

# Private gateway only. The upstream must be an https deployment alias
# distinct from aha.oox.sh to avoid split-DNS recursion.
AHA_UPSTREAM_URL=https://aha-private-alias.example.com

# Split DNS only: point CLI API calls at the public deployment alias, since
# https://aha.oox.sh resolves to the read-only private gateway on the tailnet.
# Share URLs still default to https://aha.oox.sh/<id> via AHA_PUBLIC_URL.
# AHA_ENDPOINT=https://aha-private-alias.example.com

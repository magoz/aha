# Service (Vercel / Node server). Never commit real values.
PLANS_OWNER_TOKEN=replace-with-owner-bearer-token
PLANS_PRIVATE_READ_TOKEN=replace-with-private-read-bearer-token
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=plans-dev
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_REGION=auto
# Canonical share-URL base. Defaults to https://plans.oox.sh when unset.
# PLANS_PUBLIC_URL=https://plans.oox.sh

# Local development only.
PORT=3939
HOST=127.0.0.1
PLANS_ENDPOINT=http://127.0.0.1:3939

# Private gateway only. The upstream must be an https deployment alias
# distinct from plans.oox.sh to avoid split-DNS recursion.
PLANS_UPSTREAM_URL=https://plans-private-alias.example.com

# Split DNS only: point CLI API calls at the public deployment alias, since
# https://plans.oox.sh resolves to the read-only private gateway on the tailnet.
# Share URLs still default to https://plans.oox.sh/<id> via PLANS_PUBLIC_URL.
# PLANS_ENDPOINT=https://plans-private-alias.example.com
